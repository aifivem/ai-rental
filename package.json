{
  "name": "ai-rental",
  "version": "0.1.3",
  "private": true,
  "description": "Basic vehicle rental: panel-set rental points, fee and deposit, keys and fuel through ai-core",
  "license": "GPL-3.0-only",
  "author": {
    "name": "TGIANN"
  },
  "repository": "github:aifivem/ai-rental",
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "ai-core"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "build": "bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json && tsc --noEmit -p resource/server/tsconfig.json"
  },
  "dependencies": {
    "@aicore-fivem/lib": "workspace:*",
    "@aicore-fivem/shared": "workspace:*"
  },
  "devDependencies": {
    "@aicore-fivem/build": "workspace:*",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxFiles": [
    "data/settings.json",
    "data/vehicles.json",
    "data/locations.json"
  ]
}
